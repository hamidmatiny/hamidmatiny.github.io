---
import { site } from '../data/site';
import ContribGraph from './ContribGraph.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero-inner">
    <div class="reveal">
      <p class="hero-kicker">Portfolio · AI platforms</p>
      <h1 id="hero-title">
        Mohammadreza <span class="hero-nick">“Hamid”</span> Matiny
      </h1>
      <p class="hero-positioning">
        AI Infrastructure &amp; MLOps Engineer specializing in LLM serving, GPU orchestration, and
        production observability.
      </p>
      <p class="hero-role">
        Currently: <strong>{site.roleNote}</strong>
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={site.github} rel="noopener noreferrer" target="_blank">
          <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.86v2.76c0 .26.18.58.69.48A10 10 0 0 0 12 2z"
            ></path>
          </svg>
          GitHub
        </a>
        <a class="btn btn-ghost" href={site.linkedin} rel="noopener noreferrer" target="_blank">
          LinkedIn
        </a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>

    <aside class="hero-aside reveal" aria-label="GitHub activity">
      <p class="hero-aside-label">GitHub contributions</p>
      <ContribGraph />
    </aside>
  </div>
</section>
