---
import { site } from '../data/site';
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="section-label">Contact</p>
    <h2 class="section-title" id="contact-title">Let’s talk platforms.</h2>
    <div class="contact-panel reveal">
      <div>
        <p class="section-lead" style="margin-bottom: var(--space-4)">
          Open to conversations about AI infrastructure, LLM serving, MLOps platforms, and agentic security —
          especially roles where production reliability matters as much as model quality.
        </p>
        <p style="margin:0;color:var(--text-faint);font-size:var(--text-sm)">{site.location}</p>
      </div>
      <div class="contact-links">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn btn-ghost" href={site.linkedin} rel="noopener noreferrer" target="_blank">
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
