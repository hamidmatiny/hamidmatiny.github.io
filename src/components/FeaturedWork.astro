---
import { featured } from '../data/site';
import VulcanDiagram from './VulcanDiagram.astro';
import ArgusDiagram from './ArgusDiagram.astro';
import PrismDiagram from './PrismDiagram.astro';
import ForgeDiagram from './ForgeDiagram.astro';
import AegisDiagram from './AegisDiagram.astro';
import HydraDiagram from './HydraDiagram.astro';

const diagrams: Record<string, any> = {
  vulcan: VulcanDiagram,
  argus: ArgusDiagram,
  prism: PrismDiagram,
  forge: ForgeDiagram,
  aegis: AegisDiagram,
  hydra: HydraDiagram,
};
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <p class="section-label">Featured work</p>
    <h2 class="section-title" id="work-title">Case studies, not just repos.</h2>
    <p class="section-lead">
      Architecture, engineering decisions, and honest maturity — verified against public GitHub sources.
    </p>

    {
      featured.map((project) => {
        const Diagram = diagrams[project.id];
        return (
          <article class="case reveal" id={project.id}>
            <div>
              <div class="case-header">
                <h3 class="case-name">
                  <a href={project.url} rel="noopener noreferrer" target="_blank">
                    {project.name}
                  </a>
                </h3>
                <span class="status-pill" data-tone={project.statusTone}>
                  <span class="status-dot" aria-hidden="true" />
                  {project.statusTone === 'live'
                    ? 'Active on main'
                    : project.statusTone === 'building'
                      ? 'Early build'
                      : 'Validated'}
                </span>
              </div>
              <p class="case-tagline">{project.tagline}</p>
              <p class="case-status">{project.status}</p>

              <h4 class="case-block-title">Architecture</h4>
              <p class="case-arch">{project.architecture}</p>

              <h4 class="case-block-title">Key decisions</h4>
              <ul class="case-decisions">
                {project.decisions.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>

              <ul class="stack-list" aria-label={`${project.name} stack`}>
                {project.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>

            <div class="diagram-wrap">
              {Diagram && (
                <>
                  <h4 class="case-block-title">System shape</h4>
                  <Diagram />
                </>
              )}
              <p style="margin: var(--space-3) 0 0; font-size: var(--text-xs); color: var(--text-faint);">
                <a href={project.url} rel="noopener noreferrer" target="_blank">
                  View repository →
                </a>
              </p>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
